# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection (MongoDB Replica Set or Atlas cluster required for multi-document transactions)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/transaction-ledger?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Google OAuth2 Credentials (for Nodemailer Email Service)
EMAIL_USER=your_email@gmail.com
CLIENT_ID=your_google_client_id.apps.googleusercontent.com
CLIENT_SECRET=your_google_client_secret
REFRESH_TOKEN=your_google_refresh_token
